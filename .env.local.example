# Copy this file to .env.local and replace every placeholder with the
# corresponding value from the Minaret Network Supabase project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Enable only after Google OAuth is configured in the Supabase project.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET
NEXT_PUBLIC_DEFAULT_MOSQUE_SLUG=al-falah

# Optional: enables the site-wide AI matching assistant.
# If omitted, the assistant falls back to a simple local keyword matcher.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MATCH_MODEL=gpt-5.6-luna
