generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Mosque {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  description           String?
  address               String?
  city                  String?
  province              String?
  country               String   @default("Canada")
  logoUrl               String?
  website               String?
  communityChannelType  String?  @default("WhatsApp")
  communityChannelName  String?
  communityChannelLink  String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users                User[]
  professionals        Professional[]
  categories           Category[]
  serviceAreas         ServiceArea[]
  requests             ServiceRequest[]
  categorySuggestions  CategorySuggestion[]

  @@map("mosques")
}

model User {
  id            String   @id @default(cuid())
  supabaseId    String   @unique
  email         String   @unique
  firstName     String?
  lastName      String?
  displayName   String?
  avatarUrl     String?
  phone         String?
  whatsapp      String?
  preferredContact ContactMethod?
  role          UserRole @default(MEMBER)
  mosqueId      String?
  mosque        Mosque?  @relation(fields: [mosqueId], references: [id])
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  professionals        Professional[]
  recommendations      Recommendation[]
  serviceRequests      ServiceRequest[]
  categorySuggestions  CategorySuggestion[]
  requesterConversations Conversation[] @relation("RequesterConversations")
  sentMessages           Message[]

  @@map("users")
}

enum UserRole {
  MEMBER
  PROFESSIONAL
  ADMIN
  SUPER_ADMIN
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String
  icon        String?
  description String?
  mosqueId    String?
  mosque      Mosque?  @relation(fields: [mosqueId], references: [id])
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professionals     Professional[]
  requests          ServiceRequest[]
  sponsoredListings SponsoredListing[]
  waitlistEntries   SponsoredWaitlist[]
  pricingTiers      SponsoredPricingTier[]

  @@unique([slug, mosqueId])
  @@map("categories")
}

model ServiceArea {
  id       String  @id @default(cuid())
  name     String
  slug     String
  city     String?
  province String?
  country  String  @default("Canada")
  mosqueId String?
  mosque   Mosque? @relation(fields: [mosqueId], references: [id])

  professionals     Professional[]
  requests          ServiceRequest[]
  sponsoredListings SponsoredListing[]
  waitlistEntries   SponsoredWaitlist[]
  pricingTiers      SponsoredPricingTier[]

  @@unique([slug, mosqueId])
  @@map("service_areas")
}

model Professional {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mosqueId          String?
  mosque            Mosque?            @relation(fields: [mosqueId], references: [id])
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id])
  businessName      String?
  title             String?
  bio               String?
  yearsOfExperience Int?
  qualifications    String?
  licenses          String?
  languages         String[]           @default([])
  gender            Gender?
  phone             String?
  email             String?
  website           String?
  whatsapp          String?
  photoUrl          String?
  logoUrl           String?
  status            ProfessionalStatus @default(PENDING)
  isVerified        Boolean            @default(false)
  isFeatured        Boolean            @default(false)
  isSponsored       Boolean            @default(false)
  profileViews      Int                @default(0)
  searchAppearances Int                @default(0)
  contactClicks     Int                @default(0)
  availability      String?
  rejectionReason   String?
  submittedAt       DateTime           @default(now())
  approvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  serviceAreas      ServiceArea[]
  badges            VerificationBadge[]
  recommendations   Recommendation[]
  credentials       Credential[]
  galleryImages     GalleryImage[]
  serviceRequests   ServiceRequest[]
  sponsoredListings SponsoredListing[]
  waitlistEntries   SponsoredWaitlist[]
  featuredListings  FeaturedListing[]
  featuredWaitlist  FeaturedWaitlist[]
  conversations     Conversation[]

  @@map("professionals")
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum ProfessionalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model VerificationBadge {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  type           BadgeType
  issuedAt       DateTime     @default(now())
  expiresAt      DateTime?
  notes          String?

  @@unique([professionalId, type])
  @@map("verification_badges")
}

enum BadgeType {
  MOSQUE_AFFILIATED
  HIGHLY_RECOMMENDED
}

model Credential {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  fileUrl        String
  fileType       String?
  isVerified     Boolean      @default(false)
  uploadedAt     DateTime     @default(now())

  @@map("credentials")
}

model GalleryImage {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  url            String
  caption        String?
  sortOrder      Int          @default(0)
  uploadedAt     DateTime     @default(now())

  @@map("gallery_images")
}

model Recommendation {
  id                String               @id @default(cuid())
  professionalId    String
  professional      Professional         @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  userId            String
  user              User                 @relation(fields: [userId], references: [id])
  content           String
  rating            Int                  @default(5)
  highlyRecommended Boolean              @default(false)
  status            RecommendationStatus @default(PENDING)
  moderatorNote     String?
  createdAt         DateTime             @default(now())
  approvedAt        DateTime?

  @@map("recommendations")
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Sponsored Listings ────────────────────────────────────────────────────────

model SponsoredPricingTier {
  id            String      @id @default(cuid())
  name          String
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id])
  serviceAreaId String?
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id])
  priceMonthly  Decimal     @db.Decimal(10, 2)
  maxSlots      Int         @default(2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  listings SponsoredListing[]

  @@map("sponsored_pricing_tiers")
}

model SponsoredListing {
  id             String           @id @default(cuid())
  professionalId String
  professional   Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  serviceAreaId  String
  serviceArea    ServiceArea      @relation(fields: [serviceAreaId], references: [id])
  pricingTierId  String?
  pricingTier    SponsoredPricingTier? @relation(fields: [pricingTierId], references: [id])
  priceMonthly   Decimal          @db.Decimal(10, 2)
  status         SponsoredStatus  @default(PENDING)
  startDate      DateTime?
  adminNote      String?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("sponsored_listings")
}

enum SponsoredStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
}

model SponsoredWaitlist {
  id             String      @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  serviceAreaId  String
  serviceArea    ServiceArea @relation(fields: [serviceAreaId], references: [id])
  notifiedAt     DateTime?
  createdAt      DateTime    @default(now())

  @@unique([professionalId, categoryId, serviceAreaId])
  @@map("sponsored_waitlist")
}

// ── Featured Businesses ───────────────────────────────────────────────────────

model FeaturedPricingTier {
  id           String    @id @default(cuid())
  name         String
  city         String?   // null = default for all cities
  priceMonthly Decimal   @db.Decimal(10, 2)
  maxSlots     Int       @default(6)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listings FeaturedListing[]

  @@map("featured_pricing_tiers")
}

model FeaturedListing {
  id             String          @id @default(cuid())
  professionalId String
  professional   Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  city           String
  pricingTierId  String?
  pricingTier    FeaturedPricingTier? @relation(fields: [pricingTierId], references: [id])
  priceMonthly   Decimal         @db.Decimal(10, 2)
  status         FeaturedStatus  @default(PENDING)
  startDate      DateTime?
  cancelledAt    DateTime?
  adminNote      String?
  impressions    Int             @default(0)
  cardClicks     Int             @default(0)
  websiteClicks  Int             @default(0)
  phoneClicks    Int             @default(0)
  whatsappClicks Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("featured_listings")
}

enum FeaturedStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
}

model FeaturedWaitlist {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  city           String
  notifiedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([professionalId, city])
  @@map("featured_waitlist")
}

// ── Service Requests ──────────────────────────────────────────────────────────

model ServiceRequest {
  id               String        @id @default(cuid())
  mosqueId         String
  mosque           Mosque        @relation(fields: [mosqueId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  serviceAreaId    String?
  serviceArea      ServiceArea?  @relation(fields: [serviceAreaId], references: [id])
  description      String
  preferredContact ContactMethod @default(EMAIL)
  contactValue     String?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  preferredDate    DateTime?
  status           RequestStatus @default(OPEN)
  closeReason      String?
  closeNote        String?
  closedAt         DateTime?
  assignedToId     String?
  assignedTo       Professional? @relation(fields: [assignedToId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  conversations     Conversation[]

  @@map("service_requests")
}

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

// ── Category Suggestions ──────────────────────────────────────────────────────

model Conversation {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  professionalId   String
  professional     Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        User           @relation("RequesterConversations", fields: [requesterId], references: [id], onDelete: Cascade)
  status           String         @default("OPEN")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  messages         Message[]

  @@unique([serviceRequestId, professionalId])
  @@index([requesterId, updatedAt])
  @@index([professionalId, updatedAt])
  @@map("conversation_threads")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("conversation_messages")
}

model CategorySuggestion {
  id            String    @id @default(cuid())
  name          String
  icon          String?
  mosqueId      String
  mosque        Mosque    @relation(fields: [mosqueId], references: [id])
  requestedById String
  requestedBy   User      @relation(fields: [requestedById], references: [id])
  status        String    @default("PENDING")
  adminNote     String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  @@map("category_suggestions")
}

// Lightweight first-party analytics for the self-hosted experiment.
model AnalyticsEvent {
  id         String             @id @default(cuid())
  eventType  AnalyticsEventType
  visitorId  String
  path       String?
  searchTerm String?
  region     String?
  createdAt  DateTime           @default(now())

  @@index([eventType, createdAt])
  @@index([visitorId, createdAt])
  @@index([region, createdAt])
  @@index([searchTerm, createdAt])
  @@map("analytics_events")
}

enum AnalyticsEventType {
  PAGE_VIEW
  HOME_SEARCH
}
