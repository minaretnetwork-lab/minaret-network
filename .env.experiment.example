# Local Supabase database (not exposed to the internet)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public browser endpoint. Tailscale routes only /auth/v1 and /storage/v1
# from this origin to the local Supabase gateway.
NEXT_PUBLIC_SUPABASE_URL=https://am5.tail033f8c.ts.net:8443
SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=POPULATED_BY_EXPERIMENT_SETUP
SUPABASE_SERVICE_ROLE_KEY=POPULATED_BY_EXPERIMENT_SETUP

NEXT_PUBLIC_DEFAULT_MOSQUE_SLUG=al-falah
NEXT_PUBLIC_SITE_URL=https://am5.tail033f8c.ts.net:8443

# Exact local Nominatim endpoint. The app automatically uses its bundled
# GTA/Ontario centroid fallback while the initial map import is unavailable.
NOMINATIM_URL=http://127.0.0.1:8088

# Test fixtures only. Change this before sharing the experiment publicly.
EXPERIMENT_USER_PASSWORD=GENERATED_BY_EXPERIMENT_SETUP

# Google remains the sole external auth dependency. Fill these after the
# repository owner supplies the OAuth client credentials, then enable Google
# in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
